					<div class="col-12 col-md-4 col-lg-4">
						<%= link_to '/downloads/High_School_Post_WWII_World_Order.docx', download: 'High_School_Post_WWII_World_Order.docx', class: "card carousel-card d-block text-reset text-decoration-none shadow-sm", style: "height: 500px;" do %>
							<%= image_tag 'cards/High_School_Card.jpg', class: 'card-img-top', alt: 'Card 1' %>
							<div class="card-body">
								<h4 class="card-title text-start">High School, Post WWII World Order</h4>
								<p class="card-text">Designed as an Inquiry Design Model, this lesson
									explores the post-war dynamics between the United
									States and the Soviet Union following the Second
									World War, focusing specifically on the 1950s. The
									sources selected for this lesson were collected with
									high-school learners in mind.</p>
							</div>
						<% end %>
					</div>
		
			<!-- Card 2 -->
<div class="col-12 col-md-4 col-lg-4">
	<%= link_to '/downloads/2Link_IranContra_Lesson Plan.docx', download: '2Link_IranContra_Lesson Plan.docx', class: "card carousel-card d-block text-reset text-decoration-none shadow-sm", style: "height: 500px;" do %>
		<%= image_tag 'cards/HS Iran-Contra Photo.jpg', class: 'card-img-top', alt: 'High School Iran Contra Photo' %>
		<div class="card-body">
			<h4 class="card-title text-start">High School, Iran-Contra Affair</h4>
			<p class="card-text">This lesson utilizes documents from the Iran-Contra Affair to offer students insight into the actions of both the executive and legislative branches. The goal of this lesson is for students to use primary and secondary sources to analyze the events of the Iran-Contra scandal, Congress's oversight role, and the ultimate results of those investigations.</p>
		</div>
	<% end %>
</div>

<!-- Card 3 -->
<div class="col-12 col-md-4 col-lg-4">
	<%= link_to '/downloads/2Link_Campaign Analysis Lesson Plan.docx', download: '2Link_Campaign Analysis Lesson Plan.docx', class: "card carousel-card d-block text-reset text-decoration-none shadow-sm", style: "height: 500px;" do %>
		<%= image_tag 'cards/HS Campaign Analysis.png', class: 'card-img-top', alt: 'High School Campaign Analysis' %>
		<div class="card-body">
			<h4 class="card-title text-start">High School Campaign Analysis</h4>
			<p class="card-text">This high school-focused lesson examines the strategies used in both historical and modern campaign advertisements, slogans, and posters. With a focus on critical thinking over partisanship, students will learn to consider the persuasion methods that campaigns use on the voting public.</p>
		</div>
	<% end %>
</div>
		</div>
	</div>
</section>

